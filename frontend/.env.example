# Frontend environment variables — copy to .env.local and edit

# Backend REST API base (must include /api suffix)
VITE_API_BASE_URL=http://localhost:5001/api

# Socket.io origin (no /api suffix)
VITE_SOCKET_URL=http://localhost:5001

# face-api.js model CDN — override to self-host if CDN is blocked
VITE_FACE_API_MODEL_URL=https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.13/model
